    {
      "id": "streamapi",
      "name": "StreamAPI",
      "description": "Thin client for a self-hosted strmprov aggregator server (see README) - queries multiple providers at once via HTTP and returns the combined results. Requires the server URL to be set in this provider's settings.",
      "version": "1.0.0",
      "author": "Nuvio Team",
      "supportedTypes": [
        "movie",
        "tv"
      ],
      "filename": "providers/streamapi.js",
      "enabled": true,
      "hasSettings": true,
      "formats": [
        "mp4",
        "m3u8",
        "mkv"
      ],
      "logo": "https://raw.githubusercontent.com/tapframe/nuvio-providers/main/Assets/Logo-2.png",
      "contentLanguage": [
        "en"
      ]
    },
    {
      "id": "allsources",
      "name": "All Sources",
      "description": "Combines every other scraper in this repo into one plugin, ranks the results (1080p/4K preferred for movies, everything shown for series, 30GB size cap), and returns after ~15s or once every source has answered, whichever comes first. The individual scrapers below still exist separately if you'd rather enable them one at a time.",
      "version": "1.0.0",
      "author": "Nuvio Team",
