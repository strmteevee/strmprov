{
    "name": "nuvio-providers",
    "version": "1.0.0",
    "description": "Providers for Nuvio Streaming",
    "scripts": {
        "build": "node build.js",
        "build:watch": "nodemon --watch src -e js,json --exec 'node build.js'",
        "build:provider": "node build.js",
        "serve": "node server.js",
        "addon": "node addon-server.js",
        "admin": "node admin-server.js"
    },
    "devDependencies": {
        "esbuild": "^0.20.0",
        "nodemon": "^3.0.0"
    },
    "keywords": [
        "nuvio",
        "streaming",
        "providers"
    ],
    "license": "GPL-3.0",
    "dependencies": {
        "cheerio": "^1.2.0",
        "cheerio-without-node-native": "^0.20.2",
        "crypto-js": "^4.2.0",
        "fast-xml-parser": "^5.11.1"
    }
}
